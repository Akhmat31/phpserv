{
    "name": "phx/base-router",
    "description": "Lightweight custom PHP routing engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "8.4 | >=8.2",
        "psr/http-message": "^1.1",
        "psr/http-factory": "^1.1",
        "nikic/fast-route": "^1.3",
        "league/uri": "^7.4",
        "php-di/php-di": "^7.0",
        "fig/http-message-util": "^1.1",
        "symfony/process": "^7.0",
        "symfony/yaml": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/finder": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Source\\": "core/Servers/",
            "Routes\\": "routes/",
            "PhxPlugins\\": "plugins/"
        },
        "files": [
            "plugins/PhxPlugins.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}
